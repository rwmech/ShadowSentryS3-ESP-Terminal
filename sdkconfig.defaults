CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESP32S3_DEFAULT_CPU_FREQ_240=y
CONFIG_FREERTOS_UNICORE=n
CONFIG_FREERTOS_HZ=1000
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# Elecrow CrowPanel 3.5" Terminal: ESP32-S3-WROOM-1-N16R8 (16 MB quad flash, 8 MB octal PSRAM)
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
# Internal RAM is the scarce pool (Wi-Fi, wolfSSH, task stacks, panel DMA):
# the big buffers are heap-allocated from PSRAM in code; push Wi-Fi/lwIP and
# mbedTLS (Telegram/GeoIP HTTPS) allocations out to PSRAM.
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
# OTA via POST /api/ota: a new image must reach Wi-Fi and mark itself valid,
# otherwise the bootloader rolls back to the previous slot on the next reset.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_ESP_HTTP_CLIENT_ENABLE_HTTPS=y
CONFIG_MBEDTLS_SSL_PROTO_TLS1=n
CONFIG_MBEDTLS_SSL_PROTO_TLS1_1=n
CONFIG_MBEDTLS_SSL_PROTO_TLS1_2=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
CONFIG_LWIP_MAX_SOCKETS=24
CONFIG_ESP_TASK_WDT_EN=n
# wolfSSL: compile in wolfSSH support (wc_SSH_KDF etc.) so the real SSH server builds
CONFIG_ESP_ENABLE_WOLFSSH=y
# esp_http_server: WebSocket support for the live dashboard push server
CONFIG_HTTPD_WS_SUPPORT=y
# microSD log: long file names (YYYY-MM-DD.jsonl), LFN buffer on the heap
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
# LVGL 8 front panel (480x320 landscape, RGB565 rendered, LovyanGFX converts to RGB666)
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_COLOR_16_SWAP=n
CONFIG_LV_MEM_CUSTOM=y
CONFIG_LV_DISP_DEF_REFR_PERIOD=30
CONFIG_LV_INDEV_DEF_READ_PERIOD=30
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_USE_PERF_MONITOR=n
CONFIG_LV_BUILD_EXAMPLES=n
