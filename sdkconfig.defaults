CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESP32S3_DEFAULT_CPU_FREQ_240=y
CONFIG_FREERTOS_UNICORE=n
CONFIG_FREERTOS_HZ=1000
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# Elecrow CrowPanel 3.5" Terminal: ESP32-S3-WROOM-1-N16R8 (16 MB quad flash, 8 MB octal PSRAM)
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
# Internal RAM is the scarce pool (Wi-Fi, wolfSSH, task stacks, panel DMA):
# the big buffers are heap-allocated from PSRAM in code; push Wi-Fi/lwIP and
# mbedTLS (Telegram/GeoIP HTTPS) allocations out to PSRAM.
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
# Network bisect, step 1: back to the 16 KB default (4 KB moved Wi-Fi, lwIP and mbedTLS allocations to PSRAM)
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
# OTA via POST /api/ota: a new image must reach Wi-Fi and mark itself valid,
# otherwise the bootloader rolls back to the previous slot on the next reset.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_ESP_HTTP_CLIENT_ENABLE_HTTPS=y
CONFIG_MBEDTLS_SSL_PROTO_TLS1=n
CONFIG_MBEDTLS_SSL_PROTO_TLS1_1=n
CONFIG_MBEDTLS_SSL_PROTO_TLS1_2=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
# 49 sockets needed at worst with the extra listeners (Telnet 2323, SSH 2222, ADB 5555),
# the HTTP engine (80, 8080, 8000, 9000), the 7 tripwires (one connection at a time)
# and the 10 UDP discovery listeners; FD_SETSIZE 64 leaves 14 descriptors for files
# (SPIFFS 4, FAT 4, stdio 3). 20 listening PCBs; 19 established TCP connections at
# worst, without the backlogs
CONFIG_LWIP_MAX_SOCKETS=50
# UDP PCBs: 10 discovery listeners plus DHCP, DNS, SNTP and mDNS come to about 15 of
# the default 16
CONFIG_LWIP_MAX_UDP_PCBS=24
CONFIG_LWIP_MAX_LISTENING_TCP=32
CONFIG_LWIP_MAX_ACTIVE_TCP=24
CONFIG_ESP_TASK_WDT_EN=n
# wolfSSL: compile in wolfSSH support (wc_SSH_KDF etc.) so the real SSH server builds
CONFIG_ESP_ENABLE_WOLFSSH=y
# esp_http_server: WebSocket support for the live dashboard push server
CONFIG_HTTPD_WS_SUPPORT=y
# microSD log: long file names (YYYY-MM-DD.jsonl), LFN buffer on the heap
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
# LVGL 8 front panel (480x320 landscape, RGB565 rendered, LovyanGFX converts to RGB666)
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_COLOR_16_SWAP=n
CONFIG_LV_MEM_CUSTOM=y
CONFIG_LV_DISP_DEF_REFR_PERIOD=30
CONFIG_LV_INDEV_DEF_READ_PERIOD=30
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_28=y
# 48 for "ALERT" on the red alert emblem (flash only)
CONFIG_LV_FONT_MONTSERRAT_48=y
CONFIG_LV_USE_PERF_MONITOR=n
CONFIG_LV_BUILD_EXAMPLES=n
# OV2640 (esp32-camera): SCCB on the new i2c_master driver, attached by port to
# the bus touch creates on I2C0. The legacy driver must never be linked (IDF 5.4
# aborts at boot when both are). Driver task on Core 1, with the admin world.
CONFIG_SCCB_HARDWARE_I2C_DRIVER_NEW=y
CONFIG_SCCB_HARDWARE_I2C_PORT0=y
CONFIG_CAMERA_CORE1=y
CONFIG_OV2640_SUPPORT=y
# Only the OV2640 is fitted. The other drivers' register tables are DRAM_ATTR
# (about 10 KB of internal RAM); leaving them out lets the linker drop them.
CONFIG_OV7670_SUPPORT=n
CONFIG_OV7725_SUPPORT=n
CONFIG_NT99141_SUPPORT=n
CONFIG_OV3660_SUPPORT=n
CONFIG_OV3640_SUPPORT=n
CONFIG_OV5640_SUPPORT=n
CONFIG_GC2145_SUPPORT=n
CONFIG_GC032A_SUPPORT=n
CONFIG_GC0308_SUPPORT=n
CONFIG_BF3005_SUPPORT=n
CONFIG_BF20A6_SUPPORT=n
CONFIG_SC101IOT_SUPPORT=n
CONFIG_SC030IOT_SUPPORT=n
CONFIG_SC031GS_SUPPORT=n
CONFIG_HM1055_SUPPORT=n
CONFIG_HM0360_SUPPORT=n
CONFIG_MEGA_CCM_SUPPORT=n
# Frames DMA straight into the PSRAM frame buffer, so the driver keeps no 16 KB
# bounce buffer in internal RAM (only its DMA descriptors, about 1 KB).
CONFIG_CAMERA_PSRAM_DMA=y
