#pragma once

/*
 * ShadowSentry S3 — User Configuration
 *
 * This is the ONLY file you need to edit before flashing.
 * All tuneable parameters live here; module headers contain
 * implementation constants (timeouts, backlog sizes, etc.) that
 * rarely need to change.
 *
 * Quick start:
 *   cp main/config.h.example main/config.h
 *   # edit main/config.h with your values
 *   idf.py build flash
 *
 * Minimum required changes before first flash:
 *   1. WIFI_SSID / WIFI_PASSWORD
 *   2. TELEGRAM_BOT_TOKEN / TELEGRAM_CHAT_ID  (or leave as-is to disable)
 *   3. ADMIN_PASSWORD
 */

// ── Firmware version ──────────────────────────────────────────────────────────
#define SHADOWSENTRY_VERSION        "1.0.0"

// ── Network identity ─────────────────────────────────────────────────────────
//
// Hostname sent via DHCP Option 12 — this is what appears in your router's
// device list and ARP table instead of the default "espressif".
// Choose something that fits the honeypot's cover story.

#define DEVICE_HOSTNAME             "Hikvision-NVR"

// ── mDNS (.local name resolution) ──────────────────────────────────────────────
//
// With mDNS enabled the device is always reachable at
//   http://<MDNS_HOSTNAME>.local:<ADMIN_PORT>
// from any Mac/Linux/Windows-10+/iOS/Android client on the same LAN — no need
// to know the DHCP-assigned IP.
//
// MDNS_HOSTNAME is the label before ".local": lowercase letters, digits and
// '-' only (DNS rules). MDNS_INSTANCE is the friendly name shown in service
// browsers (Bonjour / "Discovery" apps).
//
// MDNS_ADVERTISE_ADMIN:
//   1 = also announce the dashboard as an _http._tcp service, so it appears in
//       mDNS service-browser tools.
//   0 = resolve the name only, advertise no service — stealthier, since the
//       honeypot then does not actively announce an open web port.

#define MDNS_ENABLE                 1
#define MDNS_HOSTNAME               "hikvision-nvr"
#define MDNS_INSTANCE               "Hikvision NVR"
#define MDNS_ADVERTISE_ADMIN        1

// ── WiFi ─────────────────────────────────────────────────────────────────────
//
// 2.4 GHz only (ESP32-S3 limitation).
// Supports WPA2-PSK and WPA3-SAE (auto-negotiated).
// Open networks (no password) are not supported by design — a honeypot
// on an open network is itself a security risk.

#define WIFI_SSID                   "YourWiFiSSID"
#define WIFI_PASSWORD               "YourWiFiPassword"

// ── Telegram ─────────────────────────────────────────────────────────────────
//
// How to obtain:
//   Token  → send /newbot to @BotFather, copy the token it replies with
//   Chat ID → send any message to your bot, then open:
//             https://api.telegram.org/bot<TOKEN>/getUpdates
//             find "chat":{"id": ...} in the JSON response
//
// Leave both as the placeholder strings below to disable Telegram alerts
// entirely. The system detects unconfigured state by checking the first
// character of TELEGRAM_BOT_TOKEN for 'Y'.

#define TELEGRAM_BOT_TOKEN          "YOUR_BOT_TOKEN"
#define TELEGRAM_CHAT_ID            "YOUR_CHAT_ID"

// ── Discord ──────────────────────────────────────────────────────────────────
//
// Channel webhook for incident alerts and the deduplicated event log
// (Discord: channel settings, Integrations, Webhooks, New Webhook, Copy URL).
// Must start with https://discord.com/api/webhooks/ (or discordapp.com).
// The URL is a secret: anyone holding it can post to the channel. "" disables
// Discord; the dashboard's Settings page can set or clear it at run time.

#define DISCORD_WEBHOOK_URL         ""

// ── WhatsApp (CallMeBot) ─────────────────────────────────────────────────────
//
// Boot and incident alerts (opened, acknowledged, closed) to your own WhatsApp
// number through CallMeBot's free personal API. Get the apikey by following the
// activation steps on https://www.callmebot.com/blog/free-api-whatsapp-messages/
//
// WHATSAPP_PHONE is the number that activated the key, in international format
// with the country code first, e.g. "+34123123123" (no spaces).
// WHATSAPP_APIKEY is a secret. "" for either disables WhatsApp; the dashboard's
// Settings page can set or clear both at run time.

#define WHATSAPP_PHONE              ""
#define WHATSAPP_APIKEY             ""

// ── Admin panel ───────────────────────────────────────────────────────────────
//
// Dashboard is accessible at http://<device-ip>:ADMIN_PORT
// Credentials: username = "admin", password = ADMIN_PASSWORD
//
// ADMIN_PORT must be in range 1024–65535 and must not collide with any
// honeypot port. The default 9999 is deliberately obscure.
//
// ADMIN_PASSWORD minimum length is 8 characters (enforced at compile time).
// The password is never written to the serial log.

#define ADMIN_PORT                  9999
#define ADMIN_PASSWORD              "changeme1"

// Dedicated port for the live WebSocket push server (real-time dashboard feed).
// The browser connects to ws://<device-ip>:ADMIN_WS_PORT/ws; polling is the
// fallback. Unauthenticated (emits the same attack metadata as the LAN panel).
#define ADMIN_WS_PORT               9998

// ── Honeypot ports ────────────────────────────────────────────────────────────
//
// Standard ports that IoT malware and network scanners probe first.
// Changing these reduces detection coverage — do so only if there is a
// genuine port conflict on your network.

#define RTSP_PORT                   554     // Mirai / Mozi RTSP bruteforce
#define HTTP_PORT                   80      // Web scanner / NVR login harvest
#define TELNET_PORT                 23      // Telnet bruteforce (default creds)
#define SSH_PORT                    22      // SSH scanner version fingerprinting
#define FTP_PORT                    21      // FTP bruteforce (USER/PASS plaintext)

// ── Extra trap ports (fork) ───────────────────────────────────────────────────
//
// Alternate Telnet and SSH ports, served by the same Telnet and SSH tasks (one
// session at a time across both ports), and the ADB trap. 0 disables a port.
// main/honeypot/trap_listen.h has the same defaults for a config.h without them.
#define TELNET_ALT_PORT             2323    // Mirai-family Telnet bruteforce
#define SSH_ALT_PORT                2222    // SSH bruteforce on the common alt port
#define ADB_PORT                    5555    // Android Debug Bridge (TV boxes, Kimwolf, BADBOX)

// HTTP engine (main/honeypot/http_engine.c): one task serves HTTP_PORT and the
// alternate HTTP ports, up to 4 connections at once, every port with upstream's
// NVR page. Each request is logged with a label from its shape and User-Agent.
// 0 = upstream's single-port http_trap_task. main/honeypot/http_engine.h has the
// defaults and collision checks for a config.h without these.
#define HTTP_ENGINE_ENABLE          1
#define HTTP_ALT_PORT1              8080    // DShield top 10; 0 disables a port
#define HTTP_ALT_PORT2              8000
#define HTTP_ALT_PORT3              9000

// Tripwires (main/honeypot/tripwire.c): ports for services this box does not
// run. Any connection is logged as a Tripwire event and alerts: the service,
// the port and the client's first bytes in hex, then the connection is
// closed. One task, one connection at a time, 5 s each; one event per source
// and service per 30 s, more connections counted into the next one.
// TRIPWIRE_ENABLE 0 turns them all off; 0 disables one port.
// main/honeypot/tripwire.h has the defaults and checks for a config.h without these.
#define TRIPWIRE_ENABLE             1
#define TRIPWIRE_RDP_PORT           3389    // Remote Desktop (client first)
#define TRIPWIRE_VNC_PORT           5900    // VNC, sends "RFB 003.008"
#define TRIPWIRE_SMB_PORT           445     // SMB, worm propagation (client first)
#define TRIPWIRE_REDIS_PORT         6379    // Redis (client first)
#define TRIPWIRE_MYSQL_PORT         3306    // MySQL, sends a 5.7 handshake
#define TRIPWIRE_MSSQL_PORT         1433    // Microsoft SQL Server (client first)
#define TRIPWIRE_JETDIRECT_PORT     9100    // HP JetDirect raw printing (client first)

// LAN discovery listeners (main/detect/discovery.c): log only, these sockets
// never send. SSDP 1900, WS-Discovery 3702, LLMNR 5355, NBNS 137, Kasa UDP
// 9999 and 20002, LIFX 56700, PlayStation 987 and 9302, and DHCP 67 (client
// broadcasts: hostname, vendor class, parameter list) feed a seen-devices
// table: GET /api/devices and the dashboard's Devices tab. A new device,
// protocol or label is logged as a Discovery event, which opens no incident
// unless switched on under "Alert on". mDNS 5353 is not bound (the mdns
// component owns it). main/detect/discovery.h has the defaults.
#define DISCOVERY_ENABLE            1
#define DISCOVERY_DHCP              1       // 0: leave UDP 67 alone

// ── Telnet fake shell (Cowrie-style) ───────────────────────────────────────────
//
// After the Telnet honeypot collects credentials it can "accept" the login and
// drop the attacker into a fake Ubuntu shell that answers recon commands while
// logging every command they run (ATTACK_SHELL events). Capturing the post-login
// command set reveals attacker TTPs and IOCs a credential-only trap never sees.
// Nothing is ever executed — responses are canned and the filesystem fictional.
#define TELNET_SHELL_ENABLE         1       // 0 = stay a pure credential collector
#define TELNET_LOGIN_GRANT_ATTEMPT  1       // accept the Nth login (1 = first try)

// ── Storage ───────────────────────────────────────────────────────────────────
//
// Both files live in the "storage" SPIFFS partition (see partitions.csv).
//
// LOG_FILE_PATH  — binary ring dump, max LOG_RING_SIZE × sizeof(attack_log_t)
// LOG_CTR_PATH   — 4-byte uint32 all-time counter; survives log_store_clear()
//
// Memory impact: LOG_RING_SIZE × sizeof(attack_log_t) bytes are allocated in
// BSS at startup. sizeof(attack_log_t) = 4+4+6(+2 pad)+4+32+64+128 ≈ 244 B
// (aligned to ~248 B). At the default of 200 entries that is ~48 KB of SRAM.
//
// LOG_FILE_PATH is versioned ("…2.bin"): the record layout gained a src_mac
// field, so the previous on-flash dump is a different size and is ignored on
// upgrade rather than mis-parsed. Old data self-clears on first boot.

#define LOG_FILE_PATH               "/spiffs/attacks2.bin"
#define LOG_CTR_PATH                "/spiffs/total.bin"
#define LOG_RING_SIZE               200

// ── ARP-spoof / MITM monitor ────────────────────────────────────────────────────
//
// Periodically scans the lwIP ARP cache for cache-poisoning signatures and
// raises an alert (logged + Telegram) on either:
//   • the gateway's MAC changing after a stable baseline was learned, or
//   • one MAC claiming two or more distinct IPs (classic poison pattern).
//
// Scope: this sees ARP entries the device itself holds, so it detects spoofing
// that targets this host or is broadcast network-wide (bettercap/ettercap
// default). A purely point-to-point spoof between two other hosts that never
// touches this device's cache is out of scope.  All values are optional —
// arp_monitor.c falls back to these same defaults if they are omitted here.
#define ARP_MONITOR_ENABLE          1       // 0 = disable the monitor task
#define ARP_SCAN_INTERVAL_S         8       // seconds between ARP-table scans
#define ARP_ALERT_COOLDOWN_S        300     // min seconds between alerts per MAC

// ── GeoIP / threat-intel enrichment ─────────────────────────────────────────────
//
// Resolves each attacker IP to country + ISP/ASN + a reputation tag
// (hosting/proxy/mobile) and shows it in the dashboard and Telegram alert.
// Provider is ip-api.com — free and key-less, so this works out of the box.
// Private / LAN source IPs are labelled "Private LAN" without any network call.
// A background worker does the lookup, so the honeypots never block; results are
// cached by IP in RAM. All values optional — geoip.c falls back to these defaults.
#define GEOIP_ENABLE                1       // 0 = disable enrichment entirely
#define GEOIP_CACHE_SIZE            24      // distinct IPs kept in the RAM cache
#define GEOIP_QUEUE_DEPTH           8       // pending lookups before new ones drop
#define GEOIP_HTTP_TIMEOUT_MS       5000    // per-lookup HTTP timeout

// ── Wi-Fi threat monitor (radio-layer) ──────────────────────────────────────────
//
// Detects 802.11 deauthentication / disassociation attacks — including the
// single-frame deauth used to force a reconnect and capture a WPA2 handshake —
// that a TCP-stack honeypot can never see. Two independent signals:
//
//   1. Forced disconnects (primary). A deauth knocks THIS station off-air, so
//      we always observe our own disconnect. wifi_manager classifies each by its
//      802.11 reason code: a deauth-induced drop carries a low code (1-9) while
//      a benign RF loss reports 200+ (beacon-timeout / no-AP / handshake-timeout)
//      and is ignored. One deauth-attributable drop is enough to grab a handshake,
//      so the default threshold is 1 — no false positives from a flaky link.
//   2. Broadcast deauth flood (secondary). Promiscuous mode counts broadcast
//      deauth/disassoc frames sniffed on-channel (e.g. an attack aimed elsewhere).
//
// Either signal raises an ATTACK_WIFI event. All values optional — wifi_monitor.c
// falls back to these defaults.
#define WIFI_MON_ENABLE                1     // 0 = disable the monitor task
#define WIFI_MON_WINDOW_MS             2000  // tick length
#define WIFI_MON_ROLL_WINDOWS          5     // windows summed → ~10s detection span
#define WIFI_MON_DEAUTH_DISC_THRESHOLD 1     // deauth-attributable disconnects → alert
// Secondary broadcast-sniff threshold. A deauth attack knocks this station off
// the channel, so it only sniffs the flood in sporadic bursts; summing ~10s of
// windows catches a flood aimed elsewhere without firing on the near-zero
// broadcast-deauth baseline of a normal network.
#define WIFI_MON_DEAUTH_THRESHOLD      3     // broadcast deauth/disassoc within the span
#define WIFI_MON_COOLDOWN_S            60    // min seconds between Wi-Fi alerts

// ── Wi-Fi roaming ─────────────────────────────────────────────────────────────
//
// The station always joins the strongest AP for the SSID (all-channel scan,
// sorted by RSSI). With several APs on one SSID it can still sit on a far one
// after a drop, so main/wifi_roam.c re-roams: when the signal stays below
// WIFI_ROAM_RSSI_DBM for WIFI_ROAM_LOW_S seconds, it scans, and moves to a
// BSSID at least WIFI_ROAM_GAIN_DB stronger; at most one scan and roam every
// WIFI_ROAM_INTERVAL_S. The Wi-Fi threat monitor does not count a roam's own
// disconnect as a deauth. All values optional (defaults in main/wifi_roam.h).
#define WIFI_ROAM_ENABLE               1     // 0 = no re-roam (the strongest-AP join stays)
#define WIFI_ROAM_RSSI_DBM             (-75) // weak below this
#define WIFI_ROAM_LOW_S                60    // weak for this long before a scan
#define WIFI_ROAM_GAIN_DB              8     // a candidate must be this much stronger
#define WIFI_ROAM_INTERVAL_S           300   // at most one scan and roam per this

// ── Panel camera (OV2640) ─────────────────────────────────────────────────────
//
// The panel photographs whoever presses ACKNOWLEDGE, or confirms IGNORE ERROR
// or IGNORE DEVICE. With CAM_FLASH_ENABLE 1 the screen turns full white and
// the backlight full on for under a second first, to light the face, and the
// camera lets its exposure settle on that light for CAM_FLASH_SETTLE_MS
// (200..1500) before it captures. 0: no flash, the photo is taken at once.
// main/camera/cam.h has the defaults for a config.h without these.
#define CAM_FLASH_ENABLE            1
#define CAM_FLASH_SETTLE_MS         500

// ── Front panel and incident alarm (CrowPanel 3.5") ──────────────────────────
//
// DISPLAY_TZ is a POSIX TZ string for the panel clock and event times, e.g.
// "EST5EDT,M3.2.0,M11.1.0", "CET-1CEST,M3.5.0,M10.5.0/3", "UTC0".
//
// Any event opens an incident: a 3 s siren on the buzzer, then the siren
// again every ALARM_REMIND_S (60..3600) until it is acknowledged on the panel
// (hold the button) or the dashboard. An acknowledged incident closes after
// ALARM_QUIET_S without events, or at once on Re-arm; a new source re-alarms
// immediately.
#define DISPLAY_TZ                  "UTC0"
#define ALARM_REMIND_S              60
#define ALARM_QUIET_S               600

// ── Compile-time validation ───────────────────────────────────────────────────
//
// These assertions fire as build errors, not runtime panics, so
// misconfiguration is caught before the firmware ever runs on hardware.

// sizeof includes the null terminator, so an 8-char password has sizeof = 9
_Static_assert(sizeof(ADMIN_PASSWORD) >= 9,
    "ADMIN_PASSWORD must be at least 8 characters");

_Static_assert(ADMIN_PORT >= 1024 && ADMIN_PORT <= 65535,
    "ADMIN_PORT must be in range 1024–65535");

_Static_assert(ADMIN_WS_PORT >= 1024 && ADMIN_WS_PORT <= 65534,
    "ADMIN_WS_PORT must be in range 1024–65534 (its control port is +1)");
_Static_assert(ADMIN_WS_PORT != ADMIN_PORT,
    "ADMIN_WS_PORT must differ from ADMIN_PORT");

// mDNS label: at least 1 char, max 31 (RFC 1035 label limit is 63; keep margin)
_Static_assert(sizeof(MDNS_HOSTNAME) >= 2 && sizeof(MDNS_HOSTNAME) <= 32,
    "MDNS_HOSTNAME must be 1–31 characters");

_Static_assert(sizeof(WHATSAPP_PHONE) <= 17,
    "WHATSAPP_PHONE must be at most 16 characters (+ and up to 15 digits)");
_Static_assert(sizeof(WHATSAPP_APIKEY) <= 33,
    "WHATSAPP_APIKEY must be at most 32 characters");

_Static_assert(LOG_RING_SIZE >= 10 && LOG_RING_SIZE <= 500,
    "LOG_RING_SIZE must be 10–500  (500 entries ≈ 117 KB RAM)");

// Port collision guards
_Static_assert(RTSP_PORT   != HTTP_PORT,   "RTSP_PORT and HTTP_PORT must differ");
_Static_assert(RTSP_PORT   != TELNET_PORT, "RTSP_PORT and TELNET_PORT must differ");
_Static_assert(HTTP_PORT   != TELNET_PORT, "HTTP_PORT and TELNET_PORT must differ");
_Static_assert(ADMIN_PORT  != RTSP_PORT,   "ADMIN_PORT collides with RTSP_PORT");
_Static_assert(ADMIN_PORT  != HTTP_PORT,   "ADMIN_PORT collides with HTTP_PORT");
_Static_assert(ADMIN_PORT  != TELNET_PORT, "ADMIN_PORT collides with TELNET_PORT");
_Static_assert(ADMIN_PORT  != SSH_PORT,    "ADMIN_PORT collides with SSH_PORT");
_Static_assert(SSH_PORT    != RTSP_PORT,   "SSH_PORT and RTSP_PORT must differ");
_Static_assert(SSH_PORT    != HTTP_PORT,   "SSH_PORT and HTTP_PORT must differ");
_Static_assert(SSH_PORT    != TELNET_PORT, "SSH_PORT and TELNET_PORT must differ");
_Static_assert(FTP_PORT    != RTSP_PORT,   "FTP_PORT and RTSP_PORT must differ");
_Static_assert(FTP_PORT    != HTTP_PORT,   "FTP_PORT and HTTP_PORT must differ");
_Static_assert(FTP_PORT    != TELNET_PORT, "FTP_PORT and TELNET_PORT must differ");
_Static_assert(FTP_PORT    != SSH_PORT,    "FTP_PORT and SSH_PORT must differ");
_Static_assert(ADMIN_PORT  != FTP_PORT,    "ADMIN_PORT collides with FTP_PORT");

// Fork ports: 0 = disabled, never collides
#define PORT_FREE_(p) ((p) != RTSP_PORT && (p) != HTTP_PORT && (p) != TELNET_PORT && \
                       (p) != SSH_PORT && (p) != FTP_PORT && (p) != ADMIN_PORT && \
                       (p) != ADMIN_WS_PORT && (p) != ADMIN_WS_PORT + 1)
_Static_assert(TELNET_ALT_PORT == 0 || PORT_FREE_(TELNET_ALT_PORT), "TELNET_ALT_PORT collides with another port");
_Static_assert(SSH_ALT_PORT    == 0 || PORT_FREE_(SSH_ALT_PORT),    "SSH_ALT_PORT collides with another port");
_Static_assert(ADB_PORT        == 0 || PORT_FREE_(ADB_PORT),        "ADB_PORT collides with another port");
_Static_assert(TELNET_ALT_PORT == 0 || TELNET_ALT_PORT != SSH_ALT_PORT, "TELNET_ALT_PORT and SSH_ALT_PORT must differ");
_Static_assert(ADB_PORT == 0 || (ADB_PORT != TELNET_ALT_PORT && ADB_PORT != SSH_ALT_PORT),
    "ADB_PORT collides with an alternate port");

// Tripwire ports: not on another trap, admin or HTTP port (tripwire.h also
// checks that no two tripwire ports are the same)
#define TRIPWIRE_FREE_(p) ((p) == 0 || (PORT_FREE_(p) && (p) != TELNET_ALT_PORT && \
                           (p) != SSH_ALT_PORT && (p) != ADB_PORT && (p) != HTTP_ALT_PORT1 && \
                           (p) != HTTP_ALT_PORT2 && (p) != HTTP_ALT_PORT3))
_Static_assert(TRIPWIRE_FREE_(TRIPWIRE_RDP_PORT),       "TRIPWIRE_RDP_PORT collides with another port");
_Static_assert(TRIPWIRE_FREE_(TRIPWIRE_VNC_PORT),       "TRIPWIRE_VNC_PORT collides with another port");
_Static_assert(TRIPWIRE_FREE_(TRIPWIRE_SMB_PORT),       "TRIPWIRE_SMB_PORT collides with another port");
_Static_assert(TRIPWIRE_FREE_(TRIPWIRE_REDIS_PORT),     "TRIPWIRE_REDIS_PORT collides with another port");
_Static_assert(TRIPWIRE_FREE_(TRIPWIRE_MYSQL_PORT),     "TRIPWIRE_MYSQL_PORT collides with another port");
_Static_assert(TRIPWIRE_FREE_(TRIPWIRE_MSSQL_PORT),     "TRIPWIRE_MSSQL_PORT collides with another port");
_Static_assert(TRIPWIRE_FREE_(TRIPWIRE_JETDIRECT_PORT), "TRIPWIRE_JETDIRECT_PORT collides with another port");

// Discovery: on or off (its ports are UDP and fixed by the protocols)
_Static_assert(DISCOVERY_ENABLE == 0 || DISCOVERY_ENABLE == 1, "DISCOVERY_ENABLE must be 0 or 1");
_Static_assert(DISCOVERY_DHCP == 0 || DISCOVERY_DHCP == 1, "DISCOVERY_DHCP must be 0 or 1");

// Wi-Fi roaming
_Static_assert(WIFI_ROAM_ENABLE == 0 || WIFI_ROAM_ENABLE == 1, "WIFI_ROAM_ENABLE must be 0 or 1");
_Static_assert(WIFI_ROAM_RSSI_DBM >= -95 && WIFI_ROAM_RSSI_DBM <= -40, "WIFI_ROAM_RSSI_DBM must be -95..-40");
_Static_assert(WIFI_ROAM_LOW_S >= 10 && WIFI_ROAM_LOW_S <= 3600, "WIFI_ROAM_LOW_S must be 10..3600");
_Static_assert(WIFI_ROAM_GAIN_DB >= 3 && WIFI_ROAM_GAIN_DB <= 30, "WIFI_ROAM_GAIN_DB must be 3..30");
_Static_assert(WIFI_ROAM_INTERVAL_S >= 60 && WIFI_ROAM_INTERVAL_S <= 86400, "WIFI_ROAM_INTERVAL_S must be 60..86400");

// Panel camera flash
_Static_assert(CAM_FLASH_ENABLE == 0 || CAM_FLASH_ENABLE == 1, "CAM_FLASH_ENABLE must be 0 or 1");
_Static_assert(CAM_FLASH_SETTLE_MS >= 200 && CAM_FLASH_SETTLE_MS <= 1500, "CAM_FLASH_SETTLE_MS must be 200..1500");
